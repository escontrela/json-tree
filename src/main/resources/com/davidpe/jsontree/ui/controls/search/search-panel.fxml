<?xml version="1.0" encoding="UTF-8"?>

<?import com.davidpe.jsontree.ui.controls.toolbar.ToolbarIconButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="searchPanelRoot" managed="false" maxWidth="360.0" prefWidth="360.0" spacing="14.0" styleClass="search-panel-card" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidpe.jsontree.ui.controls.search.controller.SearchPanelController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <HBox fx:id="searchPanelDragHandle" alignment="CENTER_LEFT" spacing="8.0" styleClass="search-panel-drag-handle" HBox.hgrow="ALWAYS">
            <Label styleClass="eyebrow-label" text="Search" />
            <Label fx:id="searchPanelOccurrenceLabel" styleClass="search-panel-occurrence" text="Ready" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
        <ToolbarIconButton accessibleText="Close search panel"
                           darkIconResource="/com/davidpe/jsontree/images/close_35dp_FFFFFF.png"
                           lightIconResource="/com/davidpe/jsontree/images/close_35dp_000000.png"
                           onAction="#closePanel"
                           styleClass="toolbar-icon-button search-panel-close-button"
                           tooltipText="Close search panel" />
    </HBox>
    <TextField fx:id="searchPanelQueryField" onAction="#submitSearch" promptText="Regex search (Java Pattern)" />
    <Label fx:id="searchPanelHelperLabel" styleClass="search-panel-helper search-panel-helper-muted" text="Java regular expression search. Literal fallback is disabled." wrapText="true" />
    <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="search-panel-actions">
        <ToolbarIconButton fx:id="searchPanelPreviousButton"
                           accessibleText="Show previous result"
                           darkIconResource="/com/davidpe/jsontree/images/previous_35dp_FFFFFF.png"
                           disable="true"
                           lightIconResource="/com/davidpe/jsontree/images/previous_35dp_000000.png"
                           onAction="#showPreviousResult"
                           styleClass="toolbar-icon-button search-panel-icon-button"
                           tooltipText="Show previous result" />
        <ToolbarIconButton fx:id="searchPanelNextButton"
                           accessibleText="Show next result"
                           darkIconResource="/com/davidpe/jsontree/images/next_35dp_FFFFFF.png"
                           disable="true"
                           lightIconResource="/com/davidpe/jsontree/images/next_35dp_000000.png"
                           onAction="#showNextResult"
                           styleClass="toolbar-icon-button search-panel-icon-button"
                           tooltipText="Show next result" />
        <ToolbarIconButton fx:id="searchPanelClearButton"
                           accessibleText="Clear search"
                           darkIconResource="/com/davidpe/jsontree/images/clear_35dp_FFFFFF.png"
                           disable="true"
                           lightIconResource="/com/davidpe/jsontree/images/clear_35dp_000000.png"
                           onAction="#clearSearch"
                           styleClass="toolbar-icon-button search-panel-icon-button"
                           tooltipText="Clear search" />
        <ToolbarIconButton fx:id="searchPanelCropButton"
                           accessibleText="Show cropped view"
                           darkIconResource="/com/davidpe/jsontree/images/crop_35dp_FFFFFF.png"
                           disable="true"
                           lightIconResource="/com/davidpe/jsontree/images/crop_35dp_000000.png"
                           managed="false"
                           onAction="#toggleCrop"
                           styleClass="toolbar-icon-button search-panel-icon-button"
                           toggleMode="true"
                           tooltipText="Show cropped view"
                           visible="false" />
        <ToolbarIconButton fx:id="searchPanelSubmitButton"
                           accessibleText="Apply regex search"
                           darkIconResource="/com/davidpe/jsontree/images/filter_35dp_FFFFFF.png"
                           lightIconResource="/com/davidpe/jsontree/images/filter_35dp_000000.png"
                           onAction="#submitSearch"
                           styleClass="toolbar-icon-button search-panel-submit-button"
                           tooltipText="Apply regex search" />
    </HBox>
</VBox>
