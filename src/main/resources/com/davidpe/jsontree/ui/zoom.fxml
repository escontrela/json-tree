<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="app-shell zoom-window-shell" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidpe.jsontree.ui.controller.ZoomWindowController">
    <top>
        <VBox spacing="12.0" styleClass="workspace-header zoom-window-header">
            <padding>
                <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="4.0">
                    <Label fx:id="zoomModeLabel" styleClass="eyebrow-label" text="Zoom viewer" />
                    <Label fx:id="zoomTitleLabel" styleClass="viewer-card-title" text="Expanded reading surface" />
                    <Label fx:id="zoomMetaLabel" styleClass="file-meta" managed="false" visible="false" wrapText="true" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="zoomOutlineToggleButton" mnemonicParsing="false" onAction="#toggleZoomOutline" styleClass="ghost-button" text="Outline" />
                <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="ghost-button" text="Close" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="zoom-search-strip">
                <TextField fx:id="zoomSearchField" onAction="#executeSearch" promptText="Regex search" HBox.hgrow="ALWAYS" />
                <Button fx:id="zoomCropButton" disable="true" mnemonicParsing="false" onAction="#toggleCropView" styleClass="ghost-button search-strip-button" text="Crop" />
                <Button fx:id="zoomSearchPreviousButton" disable="true" mnemonicParsing="false" onAction="#showPreviousSearchResult" styleClass="ghost-button search-strip-button" text="Previous" />
                <Button fx:id="zoomSearchNextButton" disable="true" mnemonicParsing="false" onAction="#showNextSearchResult" styleClass="ghost-button search-strip-button" text="Next" />
                <Label fx:id="zoomSearchOccurrenceLabel" styleClass="zoom-search-count" text="Ready" />
            </HBox>
            <Label fx:id="zoomSearchErrorLabel" managed="false" styleClass="search-modal-error" visible="false" wrapText="true" />
            <Label fx:id="zoomBreadcrumbLabel" managed="false" styleClass="viewer-toolbar-breadcrumb zoom-breadcrumb-label" visible="false" wrapText="true" />
        </VBox>
    </top>
    <center>
        <StackPane styleClass="viewer-shell zoom-window-viewer-shell">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <StackPane fx:id="zoomViewerHost" managed="false" styleClass="zoom-window-viewer-host" visible="false" />
            <Label fx:id="zoomStateLabel" styleClass="empty-state zoom-window-empty-state" text="The current JSON presentation will appear here once the zoom viewer content is wired." wrapText="true" />
        </StackPane>
    </center>
    <right>
        <VBox fx:id="zoomOutlineVBox" prefWidth="176.0" spacing="12.0" styleClass="rail-card viewer-aid-card outline-panel">
            <BorderPane.margin>
                <Insets bottom="24.0" left="0.0" right="24.0" top="24.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label styleClass="eyebrow-label" text="Outline" />
            <Label fx:id="zoomOutlineTitleLabel" styleClass="viewer-aid-title" text="Awaiting document" />
            <StackPane fx:id="zoomOutlinePreviewShell" minHeight="260.0" prefHeight="360.0" styleClass="outline-preview-shell" VBox.vgrow="ALWAYS">
                <Canvas fx:id="zoomOutlineCanvas" mouseTransparent="true" />
                <Region fx:id="zoomOutlineViewportMarker" managed="false" mouseTransparent="true" styleClass="outline-viewport-marker" visible="false" />
                <Label fx:id="zoomOutlineStateLabel" styleClass="outline-state-label" text="Open a JSON or Markdown file in the main workspace to populate the outline minimap shell." wrapText="true" />
            </StackPane>
            <Label fx:id="zoomOutlineMetaLabel" styleClass="viewer-aid-meta" text="The panel keeps a dedicated minimap shell ready for the active document." wrapText="true" />
        </VBox>
    </right>
</BorderPane>
