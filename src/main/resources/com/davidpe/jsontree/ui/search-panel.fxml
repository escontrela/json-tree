<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="searchPanelRoot" managed="false" maxWidth="360.0" prefWidth="360.0" spacing="14.0" styleClass="search-panel-card" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidpe.jsontree.ui.controller.SearchPanelController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <HBox fx:id="searchPanelDragHandle" alignment="CENTER_LEFT" spacing="8.0" styleClass="search-panel-drag-handle">
            <Label styleClass="eyebrow-label" text="Search" />
            <Label fx:id="searchPanelOccurrenceLabel" styleClass="search-panel-occurrence" text="Ready" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#closePanel" styleClass="ghost-button search-panel-close-button" text="Close" />
    </HBox>
    <TextField fx:id="searchPanelQueryField" onAction="#submitSearch" promptText="Example: David|admin" />
    <Label fx:id="searchPanelHelperLabel" styleClass="search-panel-helper search-panel-helper-muted" text="Use a Java regular expression to search the current viewer." wrapText="true" />
    <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="search-panel-actions">
        <Button fx:id="searchPanelPreviousButton" disable="true" mnemonicParsing="false" onAction="#showPreviousResult" styleClass="ghost-button search-panel-action-button" text="Prev" />
        <Button fx:id="searchPanelNextButton" disable="true" mnemonicParsing="false" onAction="#showNextResult" styleClass="ghost-button search-panel-action-button" text="Next" />
        <Button fx:id="searchPanelClearButton" disable="true" mnemonicParsing="false" onAction="#clearSearch" styleClass="ghost-button search-panel-action-button" text="Clear" />
        <Button fx:id="searchPanelSubmitButton" mnemonicParsing="false" onAction="#submitSearch" styleClass="primary-button" text="Apply" />
    </HBox>
</VBox>
