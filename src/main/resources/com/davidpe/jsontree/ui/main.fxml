<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import com.davidpe.jsontree.ui.controls.toolbar.ToolbarIconButton?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="app-shell" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidpe.jsontree.ui.controller.MainWindowController">

    <!-- ═══ TOP: workspace header ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="workspace-header">
            <VBox spacing="8.0">
                <Label styleClass="eyebrow-label" text="Workspace" />
                <Label styleClass="app-title" text="JSON → TREE" />
                <Label styleClass="hero-support" text="Inspect JSON and Markdown with a persistent utility rail and primary viewer workspace." wrapText="true" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="header-action-bar">
                <ToolbarIconButton fx:id="settingsButton"
                                   accessibleText="Open settings"
                                   darkIconResource="/com/davidpe/jsontree/images/settings_35dp_FFFFFF.png"
                                   lightIconResource="/com/davidpe/jsontree/images/settings_35dp_000000.png"
                                   onAction="#openSettings"
                                   tooltipText="Open settings" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══ LEFT: utility rail ═══ -->
    <left>
        <VBox prefWidth="336.0" spacing="20.0" styleClass="utility-rail">
            <BorderPane.margin>
                <Insets bottom="24.0" left="24.0" right="12.0" top="24.0" />
            </BorderPane.margin>

            <VBox fx:id="fileSummaryCard" spacing="16.0" styleClass="rail-card file-summary-card">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="4.0">
                        <Label styleClass="eyebrow-label" text="Current file" />
                        <Label fx:id="fileNameLabel" styleClass="file-name" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="fileWarningIconLabel" managed="false" styleClass="warning-icon-shell" visible="false" />
                    <Label fx:id="validationStatusLabel" styleClass="status-pill" />
                </HBox>
                <Region styleClass="card-divider" />
                <Label fx:id="fileMetaLabel" styleClass="file-meta" wrapText="true" />
                <VBox spacing="10.0" styleClass="metric-stack">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-row">
                        <Label styleClass="metric-label" text="Loaded" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="fileLoadedAtValueLabel" styleClass="metric-value" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="metric-row">
                        <Label styleClass="metric-label" text="Source" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="fileSourceValueLabel" styleClass="metric-value" />
                    </HBox>
                </VBox>
            </VBox>

            <VBox spacing="12.0" styleClass="rail-card history-preview-card" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="4.0">
                        <Label styleClass="eyebrow-label" text="History" />
                        <Label fx:id="historyInlineMetaLabel" styleClass="rail-placeholder-meta" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#openHistory" styleClass="ghost-button" text="View all" />
                </HBox>
                <ListView fx:id="historyListView" prefHeight="264.0" VBox.vgrow="ALWAYS" />
                <Label fx:id="emptyHistoryInlineLabel" managed="false" styleClass="rail-placeholder-body" text="No snapshots yet. Valid imports will appear here for quick reopen." visible="false" wrapText="true" />
            </VBox>
        </VBox>
    </left>

    <!-- ═══ CENTER: viewer principal ═══ -->
    <center>
        <StackPane fx:id="workspaceOverlayShell" styleClass="workspace-overlay-shell">
            <BorderPane.margin>
                <Insets bottom="24.0" left="12.0" right="12.0" top="24.0" />
            </BorderPane.margin>
            <VBox spacing="16.0">
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="viewer-toolbar">
                    <VBox spacing="4.0">
                        <Label styleClass="eyebrow-label" text="ASCII viewer" />
                        <Label styleClass="viewer-card-title" text="Structured developer output" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="viewer-toolbar-actions">
                        <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="viewer-toolbar-button-row">
                            <HBox fx:id="largePreviewPageControls" alignment="CENTER_RIGHT" managed="false" spacing="6.0" styleClass="large-preview-page-strip" visible="false">
                                <Button fx:id="largePreviewPreviousButton" disable="true" mnemonicParsing="false" onAction="#showPreviousLargePreviewPage" styleClass="ghost-button large-preview-page-button" text="Previous" />
                                <Label fx:id="largePreviewCurrentPageLabel" styleClass="large-preview-page-label" text="Page 1" />
                                <Label fx:id="largePreviewTotalPagesLabel" styleClass="large-preview-page-meta" text="of 1" />
                                <Button fx:id="largePreviewNextButton" disable="true" mnemonicParsing="false" onAction="#showNextLargePreviewPage" styleClass="ghost-button large-preview-page-button" text="Next" />
                            </HBox>
                            <ToolbarIconButton fx:id="copyTreeButton"
                                               accessibleText="Copy tree"
                                               darkIconResource="/com/davidpe/jsontree/images/copy_35dp_FFFFFF.png"
                                               lightIconResource="/com/davidpe/jsontree/images/copy_35dp_000000.png"
                                               onAction="#copyTree"
                                               tooltipText="Copy tree" />
                            <ToolbarIconButton fx:id="rawJsonButton"
                                               accessibleText="Show raw view"
                                               darkIconResource="/com/davidpe/jsontree/images/raw_on_35dp_FFFFFF.png"
                                               disable="true"
                                               lightIconResource="/com/davidpe/jsontree/images/raw_on_35dp_000000.png"
                                               onAction="#toggleRawJson"
                                               toggleMode="true"
                                               tooltipText="Show raw view" />
                            <ToolbarIconButton fx:id="searchButton"
                                               accessibleText="Open search panel"
                                               darkIconResource="/com/davidpe/jsontree/images/search_35dp_FFFFFF.png"
                                               disable="true"
                                               lightIconResource="/com/davidpe/jsontree/images/search_35dp_000000.png"
                                               onAction="#openSearchPanel"
                                               tooltipText="Open search panel" />
                            <ToolbarIconButton fx:id="structureButton"
                                               accessibleText="Show structure view"
                                               darkIconResource="/com/davidpe/jsontree/images/structure_35dp_FFFFFF.png"
                                               disable="true"
                                               lightIconResource="/com/davidpe/jsontree/images/structure_35dp_000000.png"
                                               onAction="#toggleStructureMode"
                                               toggleMode="true"
                                               tooltipText="Show structure view" />
                            <ToolbarIconButton fx:id="cropButton"
                                               accessibleText="Show cropped view"
                                               darkIconResource="/com/davidpe/jsontree/images/crop_35dp_FFFFFF.png"
                                               disable="true"
                                               lightIconResource="/com/davidpe/jsontree/images/crop_35dp_000000.png"
                                               onAction="#toggleCropView"
                                               toggleMode="true"
                                               tooltipText="Show cropped view" />
                            <ToolbarIconButton fx:id="zoomButton"
                                               accessibleText="Open zoom viewer"
                                               darkIconResource="/com/davidpe/jsontree/images/zoom_35dp_FFFFFF.png"
                                               disable="true"
                                               lightIconResource="/com/davidpe/jsontree/images/zoom_35dp_000000.png"
                                               onAction="#openZoomViewer"
                                               tooltipText="Open zoom viewer" />
                            <ToolbarIconButton fx:id="outlineToggleButton"
                                               accessibleText="Toggle outline panel"
                                               darkIconResource="/com/davidpe/jsontree/images/outline_35dp_FFFFFFF.png"
                                               lightIconResource="/com/davidpe/jsontree/images/outline_35dp_000000.png"
                                               onAction="#toggleOutline"
                                               selected="true"
                                               toggleMode="true"
                                               tooltipText="Toggle outline panel" />
                        </HBox>
                        <Label fx:id="breadcrumbLabel" managed="false" styleClass="viewer-toolbar-breadcrumb" visible="false" wrapText="true" />
                    </VBox>
                </HBox>

                <StackPane fx:id="viewerShell" styleClass="viewer-shell" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <ScrollPane fx:id="viewerScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" pannable="true" styleClass="viewer-scroll-pane" vbarPolicy="AS_NEEDED">
                        <content>
                            <VBox fx:id="viewerContentBox" spacing="18.0" styleClass="viewer-content">
                                <padding>
                                    <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                                </padding>
                                <Region fx:id="largePreviewTopSpacer" managed="false" visible="false" />
                                <StackPane fx:id="viewerDocumentHost" managed="false" visible="false" VBox.vgrow="ALWAYS" />
                                <Label fx:id="emptyStateLabel" styleClass="empty-state" wrapText="true" />
                                <Region fx:id="largePreviewBottomSpacer" managed="false" visible="false" />
                            </VBox>
                        </content>
                    </ScrollPane>
                    <StackPane fx:id="largePreviewLoaderOverlay" alignment="BOTTOM_RIGHT" managed="false" mouseTransparent="true" styleClass="large-preview-loader-overlay" visible="false">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                        <HBox alignment="CENTER" spacing="6.0" styleClass="large-preview-loader">
                            <Region fx:id="largePreviewLoaderSquareOne" styleClass="large-preview-loader-square" />
                            <Region fx:id="largePreviewLoaderSquareTwo" styleClass="large-preview-loader-square" />
                            <Region fx:id="largePreviewLoaderSquareThree" styleClass="large-preview-loader-square" />
                            <Region fx:id="largePreviewLoaderSquareFour" styleClass="large-preview-loader-square" />
                        </HBox>
                    </StackPane>
                </StackPane>
            </VBox>
            <Pane fx:id="workspaceOverlayPane" managed="false" pickOnBounds="false" visible="false" />
        </StackPane>
    </center>

    <!-- ═══ RIGHT: outline / aid panel ═══ -->
    <right>
        <VBox fx:id="outlineVBox" prefWidth="176.0" spacing="12.0" styleClass="rail-card viewer-aid-card outline-panel">
            <BorderPane.margin>
                <Insets bottom="24.0" left="0.0" right="24.0" top="24.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label styleClass="eyebrow-label" text="Outline" />
            <Label fx:id="viewerAidTitleLabel" styleClass="viewer-aid-title" text="Awaiting document" />
            <StackPane fx:id="outlinePreviewShell" minHeight="260.0" prefHeight="360.0" styleClass="outline-preview-shell" VBox.vgrow="ALWAYS">
                <Canvas fx:id="outlineCanvas" mouseTransparent="true" />
                <Region fx:id="outlineViewportMarker" managed="false" mouseTransparent="true" styleClass="outline-viewport-marker" visible="false" />
                <Label fx:id="outlineStateLabel" styleClass="outline-state-label" text="Load a local JSON or Markdown file to prepare the outline minimap shell." wrapText="true" />
            </StackPane>
            <Label fx:id="viewerAidMetaLabel" styleClass="viewer-aid-meta" text="The panel keeps a dedicated minimap shell ready for the active document." wrapText="true" />
        </VBox>
    </right>

    <!-- ═══ BOTTOM: status rail ═══ -->
    <bottom>
        <HBox fx:id="statusRail" alignment="CENTER_LEFT" spacing="20.0" styleClass="status-rail">
            <VBox spacing="4.0">
                <Label styleClass="eyebrow-label" text="Render status" />
                <Label fx:id="footerStatusLabel" styleClass="footer-status" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="16.0" styleClass="status-rail-details">
                <VBox spacing="4.0" styleClass="status-detail-card">
                    <Label styleClass="status-detail-label" text="State" />
                    <Label fx:id="statusStateValueLabel" styleClass="status-detail-value" />
                </VBox>
                <VBox spacing="4.0" styleClass="status-detail-card">
                    <Label styleClass="status-detail-label" text="Size" />
                    <Label fx:id="statusSizeValueLabel" styleClass="status-detail-value" />
                </VBox>
                <VBox spacing="4.0" styleClass="status-detail-card">
                    <Label styleClass="status-detail-label" text="Lines" />
                    <Label fx:id="statusLinesValueLabel" styleClass="status-detail-value" />
                </VBox>
                <VBox spacing="4.0" styleClass="status-detail-card">
                    <Label styleClass="status-detail-label" text="Source" />
                    <Label fx:id="statusSourceValueLabel" styleClass="status-detail-value" />
                </VBox>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
