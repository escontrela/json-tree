<?xml version="1.0" encoding="UTF-8"?>

<?import com.davidpe.jsontree.ui.support.ControllerAwareBorderPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<ControllerAwareBorderPane fx:id="rootPane"
                           xmlns="http://javafx.com/javafx/21"
                           xmlns:fx="http://javafx.com/fxml/1"
                           fx:controller="com.davidpe.jsontree.ui.controller.MainWindowController"
                           styleClass="app-shell">
    <center>
        <HBox spacing="24.0" styleClass="layout-shell">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>
            <VBox prefWidth="336.0" spacing="20.0" styleClass="utility-rail">
                <VBox spacing="16.0" styleClass="rail-card file-summary-card">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="4.0">
                            <Label styleClass="eyebrow-label" text="Current file"/>
                            <Label fx:id="fileNameLabel" styleClass="file-name"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="validationStatusLabel" styleClass="status-pill"/>
                    </HBox>
                    <Region styleClass="card-divider"/>
                    <Label fx:id="fileMetaLabel" styleClass="file-meta" wrapText="true"/>
                </VBox>

                <VBox spacing="12.0" styleClass="rail-card history-preview-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>
                    <Label styleClass="eyebrow-label" text="History"/>
                    <Label styleClass="rail-placeholder-title" text="Inline history list"/>
                    <Label styleClass="rail-placeholder-body" text="Recent local snapshots will live here so the left rail can support quick reopen without leaving the viewer." wrapText="true"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="rail-placeholder-meta" text="Dedicated history screen remains the full archive." wrapText="true"/>
                </VBox>

                <VBox spacing="12.0" styleClass="rail-card import-utility-card">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>
                    <Label styleClass="eyebrow-label" text="Import"/>
                    <Label styleClass="rail-placeholder-title" text="Drop JSON anywhere in this window"/>
                    <Label styleClass="rail-placeholder-body" text="This block is informational only. The full window remains the drop target so the layout stays light and consistent with the product rules." wrapText="true"/>
                </VBox>
            </VBox>

            <VBox spacing="20.0" styleClass="workspace-shell" HBox.hgrow="ALWAYS">
                <VBox spacing="8.0" styleClass="workspace-header">
                    <Label styleClass="eyebrow-label" text="Workspace"/>
                    <Label styleClass="app-title" text="JSON → TREE"/>
                    <Label styleClass="hero-support" text="Inspect JSON as a structured ASCII tree with a persistent utility rail and primary viewer workspace." wrapText="true"/>
                </VBox>
                <StackPane fx:id="viewerShell" styleClass="viewer-shell" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>
                    <ScrollPane fx:id="viewerScrollPane" fitToHeight="false" fitToWidth="false" hbarPolicy="AS_NEEDED" pannable="true" vbarPolicy="AS_NEEDED">
                        <content>
                            <VBox fx:id="viewerContentBox" spacing="18.0" styleClass="viewer-content">
                                <padding>
                                    <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
                                </padding>
                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="viewer-card-header">
                                    <VBox spacing="6.0">
                                        <Label styleClass="eyebrow-label" text="ASCII viewer"/>
                                        <Label styleClass="viewer-card-title" text="Structured developer output"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label styleClass="viewer-card-meta" text="Primary inspection workspace"/>
                                </HBox>
                                <Region styleClass="viewer-divider"/>
                                <Label fx:id="emptyStateLabel" styleClass="empty-state" wrapText="true"/>
                                <TextFlow fx:id="treeContentFlow" styleClass="tree-content" visible="false"/>
                            </VBox>
                        </content>
                    </ScrollPane>
                </StackPane>
                <VBox spacing="4.0" styleClass="status-rail">
                    <Label styleClass="eyebrow-label" text="Render status"/>
                    <Label fx:id="footerStatusLabel" styleClass="footer-status"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox managed="false" visible="false">
            <VBox spacing="4.0">
                <Label styleClass="eyebrow-label" text="Legacy footer"/>
                <Label styleClass="footer-status" text="Unused"/>
            </VBox>
        </HBox>
    </bottom>
</ControllerAwareBorderPane>
